# =========================================================================
# SQL Server Review MCP - environment configuration
# Copy this file to `.env` and fill in values. NEVER commit the real `.env`.
# =========================================================================

# --- Connection ----------------------------------------------------------
SQLSERVER_HOST=
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=
SQLSERVER_USER=
SQLSERVER_PASSWORD=

# Set to true to use Windows/Integrated auth instead of SQL auth.
# When true, SQLSERVER_USER/SQLSERVER_PASSWORD are ignored.
SQLSERVER_USE_WINDOWS_AUTH=false

# Set to true when connecting to Azure SQL Database with Entra ID
# (Azure AD) authentication via a service principal / default credential.
SQLSERVER_USE_AZURE_AD=false

SQLSERVER_ENCRYPT=true
SQLSERVER_TRUST_SERVER_CERTIFICATE=false

# --- Feature toggles -------------------------------------------------------
# Gates sqlserver.execute_select and sqlserver.get_estimated_plan — the only
# two tools that run CALLER-SUPPLIED SQL text (guarded, but still the
# highest-risk tools here). Disabled by default; every other tool only ever
# runs fixed queries this codebase wrote itself and is unaffected. Only
# enable this once SQLSERVER_USER is the locked-down mcp_code_review login,
# never a broad test/admin account. See sql/create-review-user.sql.
SQLSERVER_ENABLE_AD_HOC_SQL=false

# --- Limits & timeouts -----------------------------------------------------
SQLSERVER_QUERY_TIMEOUT_MS=15000
SQLSERVER_CONNECTION_TIMEOUT_MS=10000
SQLSERVER_MAX_ROWS=1000
SQLSERVER_DEFAULT_ROWS=100
SQLSERVER_MAX_QUERY_TEXT_CHARS=8000
SQLSERVER_MAX_PLAN_XML_CHARS=200000
SQLSERVER_POOL_MAX=5
SQLSERVER_POOL_MIN=0

# --- Logging / audit -------------------------------------------------------
MCP_LOG_LEVEL=info
MCP_AUDIT_LOG=true

# --- Redaction ---------------------------------------------------------
# Comma-separated list of column-name substrings (case-insensitive) whose
# values are replaced with ***REDACTED*** in any tool response.
MCP_REDACT_COLUMNS=password,password_hash,token,secret,ssn,credit_card,api_key,connection_string
